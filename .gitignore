# Local environment and caches
.DS_Store
**/.DS_Store
.venv/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc
*.egg-info/
data_cache/
tmp/

# Local experiment reruns. The complete certified release is tracked.
results/*
!results/release/
!results/release/**

# LaTeX build debris. Final PDFs live in papers/v4/pdf/.
*.aux
*.log
*.out
*.toc
*.xdv
*.synctex.gz
papers/v4/*.pdf

# Deprecated pre-cleanup locations should not reappear.
legacy/
output/
paper_versions/

# Editor and scratch files
*~
*.swp
